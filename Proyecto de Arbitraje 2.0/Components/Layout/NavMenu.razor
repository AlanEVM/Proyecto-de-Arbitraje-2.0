@inject ProyectoArbitraje.Services.TorneoActualService TorneoActual
@inject NavigationManager Nav
@implements IDisposable

@code {
    private bool menuMovilAbierto = false;
    private bool menuUsuarioAbierto = false;

    private void AlternarMenuUsuario()
    {
        menuUsuarioAbierto = !menuUsuarioAbierto;
    }

    protected override void OnInitialized()
    {
        TorneoActual.OnCambio += Refrescar;
        Nav.LocationChanged += CerrarAlNavegar;
    }

    private void Refrescar()
    {
        InvokeAsync(StateHasChanged);
    }

    private void CerrarAlNavegar(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (menuMovilAbierto || menuUsuarioAbierto)
        {
            menuMovilAbierto = false;
            menuUsuarioAbierto = false;
            InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        TorneoActual.OnCambio -= Refrescar;
        Nav.LocationChanged -= CerrarAlNavegar;
    }

    private void AlternarMenuMovil()
    {
        menuMovilAbierto = !menuMovilAbierto;
    }

    private void IrAInicio()
    {
        menuMovilAbierto = false;
        TorneoActual.SalirDelTorneo();
        Nav.NavigateTo("/");
    }
}

<div class="topbar">
    <button class="menu-hamburguesa" @onclick="AlternarMenuMovil" aria-label="Abrir menú">☰</button>

    <div class="topbar-brand">Gestión de Arbitraje</div>

    <div class="topbar-side topbar-side-right @(menuMovilAbierto ? "menu-movil-abierto" : "")">
        <a class="topbar-link" href="" @onclick="IrAInicio" @onclick:preventDefault="true">Inicio</a>
        <AuthorizeView Context="sesion">
            <Authorized>
                @if (TorneoActual.TorneoId == null)
                {
                    <AuthorizeView Roles="Admin,Organizador" Context="rolTorneos">
                        <Authorized>
                            <NavLink class="topbar-link" href="torneos">Torneos</NavLink>
                        </Authorized>
                        <NotAuthorized>
                            <NavLink class="topbar-link" href="torneos">Entrar a un Torneo</NavLink>
                        </NotAuthorized>
                    </AuthorizeView>
                }
                else
                {
                    <AuthorizeView Roles="Admin,Organizador" Context="rolPosRep">
                        <Authorized>
                            <NavLink class="topbar-link" href="posiciones">Posiciones</NavLink>
                            <NavLink class="topbar-link" href="reporte">Reporte</NavLink>
                        </Authorized>
                    </AuthorizeView>
                }
                <div class="dropdown">
                    <span class="topbar-link" @onclick="AlternarMenuUsuario">@(sesion.User.Identity?.Name ?? "Usuario") ▾</span>
                    <div class="dropdown-menu @(menuUsuarioAbierto ? "abierto" : "")">
                        <AuthorizeView Roles="Admin" Context="rolMenuUsuario">
                            <Authorized>
                                <a href="ranking">Ranking</a>
                                <a href="usuarios">Usuarios</a>
                                <a href="respaldo">Respaldo</a>
                            </Authorized>
                        </AuthorizeView>
                        <form method="post" action="/logout">
                            <AntiforgeryToken />
                            <button type="submit" style="display:block; width:100%; text-align:left; background:none; border:none; cursor:pointer; font:inherit; padding:8px 16px; margin:0;">Cerrar sesión</button>
                        </form>
                    </div>
                </div>
            </Authorized>
            <NotAuthorized>
                <a class="topbar-link" href="/login">Iniciar sesión</a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

@if (TorneoActual.TorneoId != null)
{
    <div class="subbar @(menuMovilAbierto ? "menu-movil-abierto" : "")">
        <AuthorizeView Roles="Admin,Organizador" Context="rolSubAdmin1">
            <Authorized>
                <NavLink class="topbar-link" href="torneo-dashboard">Panel</NavLink>
                <NavLink class="topbar-link" href="config-torneo">Categorías</NavLink>
                <NavLink class="topbar-link" href="registro">Registro</NavLink>
            </Authorized>
        </AuthorizeView>
        <NavLink class="topbar-link" href="atletas">Atletas</NavLink>
        @if (TorneoActual.ModalidadTorneo == "Jornadas")
        {
            <NavLink class="topbar-link" href="jornadas">Jornadas</NavLink>
        }
        else
        {
            <NavLink class="topbar-link" href="calendario">Calendario</NavLink>

            @if (TorneoActual.ModalidadTorneo == "GruposFaseFinal")
            {
                <NavLink class="topbar-link" href="grupos">Grupos</NavLink>
            }
        }
        <NavLink class="topbar-link" href="fasefinal">Fase Final</NavLink>
        @if (TorneoActual.ModalidadTorneo != "Jornadas")
        {
            <AuthorizeView Context="rolSubCanchas">
                <Authorized>
                    <NavLink class="topbar-link" href="config-canchas">Canchas</NavLink>
                </Authorized>
            </AuthorizeView>
        }
    </div>
}