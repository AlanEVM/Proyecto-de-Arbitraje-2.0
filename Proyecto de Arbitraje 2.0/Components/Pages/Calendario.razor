    private async Task AbrirCorreccion(PartidoQueueItem item)
    {
        corrigiendoPartidoId = item.Partido.Id;

        var sets = item.Partido.SetsPartidos.OrderBy(s => s.NumeroSet).ToList();
        s1aC = sets.Count > 0 ? sets[0].PuntosA : 0;
        s1bC = sets.Count > 0 ? sets[0].PuntosB : 0;
        s2aC = sets.Count > 1 ? sets[1].PuntosA : 0;
        s2bC = sets.Count > 1 ? sets[1].PuntosB : 0;
        s3aC = sets.Count > 2 ? sets[2].PuntosA : 0;
        s3bC = sets.Count > 2 ? sets[2].PuntosB : 0;

        using var db = await DbFactory.CreateDbContextAsync();
        var config = await db.Configuracions.FirstOrDefaultAsync(c => c.CategoriaId == item.Partido.CategoriaId);
        modalidadSetsCorr = config?.ModalidadSets ?? "2 de 3 Sets";
        puntosJuegoCorr = config?.PuntosJuego ?? 21;
        puntosLimiteCorr = config?.PuntosLimite ?? 30;
    }

    private void CancelarCorreccion()
    {
        corrigiendoPartidoId = null;
    }

    private async Task GuardarCorreccion(int partidoId)
    {
        bool confirmado = await JS.InvokeAsync<bool>("confirm", "¿Corregir este resultado? Se recalculan las estadísticas del grupo/jornada");
        if (!confirmado) return;

        var (ok, msg) = await CalendarioSvc.CorregirResultadoAsync(
            partidoId, s1aC, s1bC, s2aC, s2bC, s3aC, s3bC,
            modalidadSetsCorr, puntosJuegoCorr, puntosLimiteCorr, nombreUsuarioActual);

        MostrarMensaje(msg, ok);

        if (ok)
        {
            corrigiendoPartidoId = null;
            await Refrescar();
        }
    }

    private async Task CargarProgresoJornadasAsync()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        var idsJornadas = categorias!.Where(c => c.Formato == "Jornadas").Select(c => c.Id).ToList();

        progresoJornadasPorCategoria.Clear();
        foreach (var catId in idsJornadas)
        {
            int vueltas = (await db.Configuracions.FirstOrDefaultAsync(c => c.CategoriaId == catId))?.NumeroVueltas ?? 1;
            int activos = await db.Competidores.CountAsync(c => c.CategoriaId == catId && c.Activo);
            int totalJornadas = CalendarioService.CalcularTotalJornadas(activos, vueltas);
            int ultimaGenerada = await db.Partidos
                .Where(p => p.CategoriaId == catId && p.Fase == "Liga")
                .Select(p => (int?)p.Jornada)
                .MaxAsync() ?? 0;

            progresoJornadasPorCategoria[catId] = new ProgresoJornadas { TotalJornadas = totalJornadas, UltimaGenerada = ultimaGenerada };
        }
    }
}