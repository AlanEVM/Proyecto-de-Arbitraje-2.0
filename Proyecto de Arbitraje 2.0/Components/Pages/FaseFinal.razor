    private async Task SortearConSembradosManuales()
    {
        mensaje = "";

        if (sembradosManualSeleccion.Any(id => id == 0) || sembradosManualSeleccion.Distinct().Count() != sembradosManualSeleccion.Count)
        {
            mensaje = "Elige un atleta distinto para cada posición de sembrado.";
            esExito = false;
            return;
        }

        var (ok, msg, propuesta) = await FaseFinalSvc.PrepararEliminatoriaManualAsync(categoriaSeleccionadaId, sembradosManualSeleccion);
        mensaje = msg; esExito = ok;
        propuestaEliminatoria = ok ? propuesta : null;
    }

