@page "/fasefinal"
@implements IDisposable
@using Microsoft.AspNetCore.Authorization
@using ProyectoArbitraje.Data
@using ProyectoArbitraje.Models
@using ProyectoArbitraje.Services
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<TorneoContext> DbFactory
@inject TorneoActualService TorneoActual
@inject FaseFinalService FaseFinalSvc
@inject CalendarioService CalendarioSvc
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@inject TorneoEventBus EventBus
@inject NavigationManager Navigation

<PageTitle>Fase Final</PageTitle>

@if (TorneoActual.TorneoId == null)
{
    <div class="pagina">
        <p class="vacio">No hay un torneo activo. <a href="">Ve a Inicio</a> y entra a uno primero.</p>
    </div>
    return;
}

<div class="pagina">
    <div class="tarjeta-marcador pagina-header">
        <h1>Fase Final - @TorneoActual.NombreTorneo</h1>
    </div>

    @if (partidosActivosTorneo.Any())
    {
        <div class="tarjeta no-imprimir">
            <h2>Partidos activos en cancha</h2>
            @foreach (var item in partidosActivosTorneo)
            {
                <div class="categoria-generar-row">
                    <span class="categoria-generar-nombre">
                        @(item.CanchaNumero != null ? $"Cancha {item.CanchaNumero} · " : "")@item.Categoria - @item.NombreA vs @item.NombreB
                    </span>
                    <button class="btn btn-ghost" @onclick="() => IrACategoria(item.CategoriaId)">Ir a esta categoría</button>
                </div>
            }
        </div>
    }

    <div class="tarjeta no-imprimir">
        <h2>1. Selecciona la categoría</h2>

        @if (categorias != null)
        {
            <div class="campo" style="max-width:400px;">
                <select @bind="categoriaSeleccionadaId" @bind:after="CargarBracket">
                    <option value="0">-- Selecciona --</option>
                    @foreach (var c in categorias)
                    {
                        <option value="@c.Id">@c.Nombre - @c.Modalidad - @c.Rama (@c.Formato)</option>
                    }
                </select>
            </div>
        }
    </div>

    @if (categoriaSeleccionadaId != 0)
    {
        @if (bracket == null || !bracket.Any())
        {
            <div class="tarjeta no-imprimir">
                @if (esSoloLectura)
                {
                    <p class="vacio">Todavía no hay fase final generada para esta categoría.</p>
                }
                else
                {
                    @if (CategoriaSeleccionada?.Formato == "Eliminatoria")
                    {
                        <h2>Sortear bracket</h2>
                        <p class="nota">Sembrados configurados: @cantidadSembradosConfigurada (se cambia desde Categorías).</p>

                        @if (propuestaEliminatoria == null)
                        {
                            @if (competidoresParaSembrado != null && competidoresParaSembrado.Count >= 2 && competidoresParaSembrado.Count <= 7)
                            {
                                <p class="mensaje-aviso">Esta categoría tiene @competidoresParaSembrado.Count atletas activos (7 o menos), así que no se arma bracket — se juega todos contra todos. Genera sus partidos desde la página "Calendario" (o cerrando el registro desde "Registro").</p>
                            }
                            else if (competidoresParaSembrado != null && competidoresParaSembrado.Count == 0)
                            {
                                <p class="vacio">No hay atletas registrados en esta categoría todavía. Regístralos en "Registro" antes de sortear el bracket.</p>
                            }
                            else if (competidoresParaSembrado != null && cantidadSembradosConfigurada > 0 && competidoresParaSembrado.Count < cantidadSembradosConfigurada)
                            {
                                <p class="mensaje-error">Se configuraron @cantidadSembradosConfigurada sembrados, pero solo hay @competidoresParaSembrado.Count atleta(s) activo(s) registrado(s) en esta categoría. Registra más atletas o baja la cantidad de sembrados en "Categorías" antes de sortear.</p>
                            }
                            else if (cantidadSembradosConfigurada == 0 || hayPuntosRanking == true)
                            {
                                <button class="btn btn-primary" @onclick="SortearEliminatoria">Sortear</button>
                            }
                            else if (hayPuntosRanking == false && competidoresParaSembrado != null)
                            {
                                <p class="mensaje-aviso">Ningún atleta tiene puntos de ranking previos, así que elige a mano quién queda sembrado y en qué posición.</p>

                                @for (int i = 0; i < cantidadSembradosConfigurada; i++)
                                {
                                    int posicion = i;
                                    <div class="campo" style="max-width:280px;">
                                        <label>Sembrado #@EtiquetaSembrado(posicion + 1)</label>
                                        <select @bind="sembradosManualSeleccion[posicion]">
                                            <option value="0">-- Selecciona --</option>
                                            @foreach (var comp in competidoresParaSembrado.Where(c => c.Id == sembradosManualSeleccion[posicion] || !sembradosManualSeleccion.Contains(c.Id)))
                                            {
                                                <option value="@comp.Id">@comp.Nombre (@comp.Municipio)</option>
                                            }
                                        </select>
                                    </div>
                                }

                                <button class="btn btn-primary" @onclick="SortearConSembradosManuales">Sortear</button>
                            }
                        }

                        @if (propuestaEliminatoria != null)
                        {
                            <h3 style="margin-top:20px;">Propuesta de llave</h3>

                            <div class="bracket-wrapper" style="overflow-x:visible;">
                                <div class="bracket-grid" style="grid-template-rows:auto repeat(@(propuestaEliminatoria.Count / 2), minmax(78px, 1fr)); grid-template-columns: 1fr; min-width:280px; max-width:420px;">
                                    @for (int i = 0; i < propuestaEliminatoria.Count; i += 2)
                                    {
                                        var a = propuestaEliminatoria[i];
                                        var b = propuestaEliminatoria[i + 1];
                                        int filaVisual = PosicionVisual(i / 2, propuestaEliminatoria.Count / 2);

                                        <div class="bracket-slot" style="grid-column:1; grid-row:@(filaVisual + 2) / span 1;">
                                            <div class="bracket-match">
                                                <div class="bracket-competidor">
                                                    <span class="bracket-nombre">
                                                        @if (a.EsSembrado)
                                                        {
                                                            <span class="bracket-seed">@EtiquetaSembrado(a.NumeroSeed ?? 0)</span>
                                                        }
                                                        @a.Nombre
                                                    </span>
                                                </div>
                                                <div class="bracket-competidor">
                                                    <span class="bracket-nombre">
                                                        @if (b.EsSembrado)
                                                        {
                                                            <span class="bracket-seed">@EtiquetaSembrado(b.NumeroSeed ?? 0)</span>
                                                        }
                                                        @b.Nombre
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div style="margin-top:12px;">
                                @if (cantidadSembradosConfigurada == 0 || hayPuntosRanking == true)
                                {
                                    <button class="btn btn-secondary" @onclick="SortearEliminatoria">Sortear de nuevo</button>
                                }
                                else
                                {
                                    <button class="btn btn-secondary" @onclick="SortearConSembradosManuales">Sortear de nuevo</button>
                                }
                                <button class="btn btn-primary" @onclick="ConfirmarEliminatoria">Confirmar bracket</button>
                            </div>
                        }
                    }
                    else if (CategoriaSeleccionada?.Formato == "Jornadas")
                    {
                        <p class="nota">Cuando todas las jornadas ya se hayan jugado, genera las llaves de eliminación por bandas de 4 (según la tabla general).</p>
                        <button class="btn btn-primary" @onclick="GenerarBandas">Generar Llaves de Eliminación</button>
                    }
                    else
                    {
                        <p class="nota">Esta categoría todavía no tiene fase final generada.</p>
                        <button class="btn btn-primary" @onclick="GenerarBracket">Generar Fase Final</button>
                    }

                    @if (!string.IsNullOrEmpty(mensaje))
                    {
                        <p class="@(esExito ? "mensaje-exito" : "mensaje-error") mensaje-flotante">@mensaje</p>
                    }
                }
            </div>
        }
        else
        {
            @foreach (var banda in bracket.Select(x => x.Banda).Distinct().OrderBy(b => b ?? 0))
            {
                var fasesRonda = bracket.Where(x => x.Banda == banda)
                    .Select(x => x.Fase).Distinct()
                    .OrderBy(f => OrdenFase.GetValueOrDefault(f, 99))
                    .ToList();

                if (!fasesRonda.Any()) continue;

                int totalFilas = bracket.Count(x => x.Banda == banda && x.Fase == fasesRonda[0]);
                var seeds = CalcularSeeds(bracket.Where(x => x.Banda == banda && x.Fase == fasesRonda[0]).ToList());
                var sembradosYaMostrados = new HashSet<int>();
                int? rondaFocoActual = rondaEnfocada.GetValueOrDefault(banda ?? 0, null);

                string columnasTemplate = "110px " + string.Join(" ",
                    Enumerable.Range(0, fasesRonda.Count).SelectMany(r =>
                        r < fasesRonda.Count - 1 ? new[] { "minmax(230px,1fr)", "64px" } : new[] { "minmax(230px,1fr)" }));

                <div class="tarjeta">
                    @if (banda != null)
                    {
                        <h2>Llave @banda</h2>
                    }
                    
                    <div class="bracket-controles">
                        @for (int r = 0; r < fasesRonda.Count; r++)
                        {
                            int rLocal = r;
                            <button class="btn btn-ghost" @onclick="() => IrARonda(banda, rLocal, fasesRonda)">@fasesRonda[rLocal]</button>
                        }
                        <button class="btn btn-secondary" @onclick="() => VerTodo(banda)">Ver todo</button>
                        <button class="btn btn-ghost" @onclick="() => Imprimir(banda)">Imprimir</button>
                    </div>
                    
                    <div id="bracket-wrap-@(banda ?? 0)" class="bracket-wrapper">
                        <div class="bracket-grid" style="--filas:@totalFilas; grid-template-columns:@columnasTemplate;">

                            <div class="bracket-titulo-equipo">Equipo</div>
                            @for (int r = 0; r < fasesRonda.Count; r++)
                            {
                                string fase = fasesRonda[r];
                                var itemsRonda = bracket.Where(x => x.Banda == banda && x.Fase == fase).OrderBy(x => x.Posicion).ToList();
                                int span = 1 << r;
                                int col = 2 * r + 2;
                                bool esUltima = r == fasesRonda.Count - 1;
                                bool atenuada = rondaFocoActual.HasValue && rondaFocoActual != r;
                                bool enfocada = rondaFocoActual == r;
                                string claseZoom = atenuada ? "atenuada" : (enfocada ? "enfocada" : "");

                                <div id="ronda-@(banda ?? 0)-@r" class="bracket-titulo-ronda @claseZoom" style="grid-column:@col;" @onclick="() => IrARonda(banda, r, fasesRonda)">@fase</div>

                                @foreach (var item in itemsRonda)
                                {
                                    int gridStart = PosicionVisual(item.Posicion, itemsRonda.Count) * span + 2;

                                    @if (r == 0)
                                    {
                                        <div class="bracket-equipo-label" style="grid-row:@gridStart / span @span;">
                                            @if (item.Partido != null)
                                            {
                                                <span>@string.Join(" / ", item.Partido.CompetidorA.CompetidorIntegrantes.Select(ci => ci.Atleta.Municipio.Nombre).Distinct())</span>
                                                <span>@string.Join(" / ", item.Partido.CompetidorB.CompetidorIntegrantes.Select(ci => ci.Atleta.Municipio.Nombre).Distinct())</span>
                                            }
                                            else if (item.CompetidorConBye != null)
                                            {
                                                <span>@string.Join(" / ", item.CompetidorConBye.CompetidorIntegrantes.Select(ci => ci.Atleta.Municipio.Nombre).Distinct())</span>
                                            }
                                        </div>
                                    }

                                    <div class="bracket-slot @claseZoom" style="grid-column:@col; grid-row:@gridStart / span @span;">
                                        @if (item.Partido != null)
                                        {
                                            var p = item.Partido;
                                            bool estaCapturando = partidoCapturandoId == p.Id;
                                            string nombreA = string.Join(" / ", p.CompetidorA.CompetidorIntegrantes.Select(ci => ci.Atleta.Nombre));
                                            string nombreB = string.Join(" / ", p.CompetidorB.CompetidorIntegrantes.Select(ci => ci.Atleta.Nombre));
                                            bool ganoA = p.Estado == "Jugado" && p.GanadorId == p.CompetidorAid;
                                            bool ganoB = p.Estado == "Jugado" && p.GanadorId == p.CompetidorBid;

                                            <div class="bracket-match @(p.Estado == "Jugado" ? "jugado" : "")">
                                                <div class="bracket-competidor @(ganoA ? "ganador" : p.Estado == "Jugado" ? "perdedor" : "")">
                                                    <span class="bracket-nombre">
                                                        @if (seeds.TryGetValue(p.CompetidorAid, out int seedA) && MostrarSembrado(seedA) && sembradosYaMostrados.Add(p.CompetidorAid))
                                                        {
                                                            <span class="bracket-seed">#@EtiquetaSembrado(seedA)</span>
                                                        }
                                                        @nombreA
                                                    </span>
                                                    @if (p.Estado == "Jugado" && (p.SetsPartidos.Any() || p.EsDefault))
                                                    {
                                                        <span class="bracket-marcador">@(p.EsDefault ? "WO" : string.Join("/", p.SetsPartidos.OrderBy(s => s.NumeroSet).Select(s => s.PuntosA)))</span>
                                                    }
                                                </div>
                                                <div class="bracket-competidor @(ganoB ? "ganador" : p.Estado == "Jugado" ? "perdedor" : "")">
                                                    <span class="bracket-nombre">
                                                        @if (seeds.TryGetValue(p.CompetidorBid, out int seedB) && MostrarSembrado(seedB) && sembradosYaMostrados.Add(p.CompetidorBid))
                                                        {
                                                            <span class="bracket-seed">#@EtiquetaSembrado(seedB)</span>
                                                        }
                                                        @nombreB
                                                    </span>
                                                    @if (p.Estado == "Jugado" && (p.SetsPartidos.Any() || p.EsDefault))
                                                    {
                                                        <span class="bracket-marcador">@(p.EsDefault ? "WO" : string.Join("/", p.SetsPartidos.OrderBy(s => s.NumeroSet).Select(s => s.PuntosB)))</span>
                                                    }
                                                </div>

                                                @if (p.Estado != "Jugado" && !esSoloLectura && !TorneoActual.CanchasConfirmadas)
                                                {
                                                    <p class="nota">Confirma las cnachas para poder actuar sobre este partido.</p>
                                                }
                                                else if (p.Estado != "Jugado" && !esSoloLectura)
                                                {
                                                    <div class="bracket-acciones-match">
                                                        @if (p.Estado == "Pendiente")
                                                        {
                                                            <button class="btn btn-primary btn-mini" @onclick="() => Activar(p.Id)">Activar</button>
                                                        }
                                                        <button class="btn btn-primary btn-mini" @onclick="() => AbrirCaptura(p.Id)">@(estaCapturando ? "Capturando..." : "Capturar")</button>
                                                        <button class="btn btn-ghost btn-mini" @onclick="() => MarcarDefault(p.Id, p.CompetidorAid, nombreA)" title="@nombreA gana por default">WO A</button>
                                                        <button class="btn btn-ghost btn-mini" @onclick="() => MarcarDefault(p.Id, p.CompetidorBid, nombreB)" title="@nombreB gana por default">WO B</button>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else if (item.CompetidorConBye != null)
                                        {
                                            string nombreBye = string.Join(" / ", item.CompetidorConBye.CompetidorIntegrantes.Select(ci => ci.Atleta.Nombre));

                                            <div class="bracket-bye">
                                                @if (seeds.TryGetValue(item.CompetidorConBye.Id, out int seedBye) && MostrarSembrado(seedBye) && sembradosYaMostrados.Add(item.CompetidorConBye.Id))
                                                {
                                                    <span class="bracket-seed">#@EtiquetaSembrado(seedBye)</span>
                                                }
                                                <strong>@nombreBye</strong>
                                                <div class="nota" style="margin-top:2px;">BYE - pasa directo</div>
                                            </div>
                                        }
                                    </div>
                                }

                                @if (!esUltima)
                                {
                                    int colGutter = col + 1;
                                    int numPares = itemsRonda.Count / 2;

                                    for (int par = 0; par < numPares; par++)
                                    {
                                        int topStart = par * 2 * span + 2;

                                        <div class="bracket-conector-par" style="grid-column:@colGutter; grid-row:@topStart / span @(span * 2);">
                                            <div class="conector-arriba"></div>
                                            <div class="conector-abajo"></div>
                                            <div class="conector-salida"></div>
                                        </div>
                                    }
                                }
                            }

                        </div>
                    </div>
                </div>
            }

            @if (partidoCapturandoId != null)
            {
                var partidoActivo = bracket.Select(x => x.Partido).FirstOrDefault(p => p != null && p.Id == partidoCapturandoId);
                if (partidoActivo != null)
                {
                    string nombreA = string.Join(" / ", partidoActivo.CompetidorA.CompetidorIntegrantes.Select(ci => ci.Atleta.Nombre));
                    string nombreB = string.Join(" / ", partidoActivo.CompetidorB.CompetidorIntegrantes.Select(ci => ci.Atleta.Nombre));

                    <div class="tarjeta no-imprimir">
                        <h3>Capturar resultado: @nombreA vs @nombreB</h3>

                            @if (esArbitro && TorneoActual.CanchasConfirmadas)
                            {
                                <div style="margin:8px 0;">
                                    <button class="btn btn-ghost btn-mini" @onclick='() => Navigation.NavigateTo($"/fasefinal/punto-punto/{partidoActivo.Id}")'>Capturar punto por punto</button>
                                </div>
                            }

                            <div class="captura-sets">
                                <div class="captura-set">
                                    <label>Set 1</label>
                                    @nombreA: <input type="number" min="0" class="input-mini" @bind="s1a" /><br />
                                    @nombreB: <input type="number" min="0" class="input-mini" @bind="s1b" />
                                </div>
                                @if (modalidadSets == "2 de 3 Sets")
                                {
                                    <div class="captura-set">
                                        <label>Set 2</label>
                                        @nombreA: <input type="number" min="0" class="input-mini" @bind="s2a" /><br />
                                        @nombreB: <input type="number" min="0" class="input-mini" @bind="s2b" />
                                    </div>
                                    <div class="captura-set">
                                        <label>Set 3</label>
                                        @nombreA: <input type="number" min="0" class="input-mini" @bind="s3a" /><br />
                                        @nombreB: <input type="number" min="0" class="input-mini" @bind="s3b" />
                                    </div>
                                }
                            </div>
                            <div style="margin-top:10px;">
                                <button class="btn btn-primary" @onclick="GuardarResultado">Guardar Resultado</button>
                                <button class="btn btn-ghost" @onclick="() => partidoCapturandoId = null">Cancelar</button>
                            </div>
                        
                    </div>
                }
            }

            @if (!string.IsNullOrEmpty(mensaje))
            {
                <p class="@(esExito ? "mensaje-exito" : "mensaje-error") mensaje-flotante">@mensaje</p>
            }
        }
    }
</div>

@code {
    private static readonly Dictionary<string, int> OrdenFase = new()
    {
        ["Dieciseisavos"] = 0,
        ["Octavos"] = 1,
        ["Cuartos"] = 2,
        ["Semifinal"] = 3,
        ["Final"] = 4,
    };

    private List<Categoria>? categorias;
    private int categoriaSeleccionadaId;
    private Categoria? CategoriaSeleccionada => categorias?.FirstOrDefault(c => c.Id == categoriaSeleccionadaId);

    private List<LlaveItem>? bracket;
    private List<SlotEliminatoria>? propuestaEliminatoria;

    private int cantidadSembradosConfigurada;
    private bool? hayPuntosRanking;
    private List<(int Id, string Nombre, int? AnioNacimiento, string Municipio)>? competidoresParaSembrado;
    private List<int> sembradosManualSeleccion = new();

    private Dictionary<int, int?> rondaEnfocada = new();

    private int? partidoCapturandoId;
    private int s1a, s1b, s2a, s2b, s3a, s3b;
    private string modalidadSets = "2 de 3 Sets";
    private int puntosJuego = 21;
    private int puntosLimite = 30;

    private string mensaje = "";
    private bool esExito;
    private bool esSoloLectura;
    private string nombreUsuarioActual = "";
    private bool esArbitro;
    private List<PartidoActivoInfo> partidosActivosTorneo = new();

    private class PartidoActivoInfo
    {
        public int PartidoId { get; set; }
        public int CategoriaId { get; set; }
        public string Categoria { get; set; } = "";
        public string NombreA { get; set; } = "";
        public string NombreB { get; set; } = "";
        public int? CanchaNumero { get; set; }
    }

    private bool modoPuntoAPunto;
    private int numeroSetActual = 1;
    private CalendarioService.EstadoSetPuntoAPunto? estadoSet;


    protected override async Task OnInitializedAsync()
    {
        if (TorneoActual.TorneoId == null) return;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        esSoloLectura = !authState.User.Identity!.IsAuthenticated;
        esArbitro = authState.User.IsInRole("Arbitro");
        nombreUsuarioActual = authState.User.Identity?.Name ?? "";

        using var db = await DbFactory.CreateDbContextAsync();
        var torneoId = TorneoActual.TorneoId!.Value;
        categorias = await db.Categorias.Where(c => c.TorneoId == torneoId).ToListAsync();

        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        if (int.TryParse(query["categoriaId"], out int catId) && categorias.Any(c => c.Id == catId))
        {
            await IrACategoria(catId);
        }

        await CargarPartidosActivosTorneo();

        EventBus.OnCambio += ManejarCambioExterno;
    }

    private async void ManejarCambioExterno()
    {
        await InvokeAsync(async () =>
        {
            await CargarBracket();
            await CargarPartidosActivosTorneo();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        EventBus.OnCambio -= ManejarCambioExterno;
    }

    private async Task CargarPartidosActivosTorneo()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        var torneoId = TorneoActual.TorneoId!.Value;
        var categoriaIds = await db.Categorias.Where(c => c.TorneoId == torneoId).Select(c => c.Id).ToListAsync();

        var partidos = await db.Partidos
            .Where(p => categoriaIds.Contains(p.CategoriaId) && p.Estado == "EnCancha" && p.Fase != "Grupos" && p.Fase != "Liga")
            .Include(p => p.Categoria)
            .Include(p => p.Cancha)
            .Include(p => p.CompetidorA).ThenInclude(c => c.CompetidorIntegrantes).ThenInclude(ci => ci.Atleta)
            .Include(p => p.CompetidorB).ThenInclude(c => c.CompetidorIntegrantes).ThenInclude(ci => ci.Atleta)
            .OrderBy(p => p.Cancha!.Numero)
            .ToListAsync();

        partidosActivosTorneo = partidos.Select(p => new PartidoActivoInfo
        {
            PartidoId = p.Id,
            CategoriaId = p.CategoriaId,
            Categoria = $"{p.Categoria.Nombre} · {p.Categoria.Modalidad} · {p.Categoria.Rama}",
            NombreA = string.Join(" / ", p.CompetidorA.CompetidorIntegrantes.Select(ci => ci.Atleta.Nombre)),
            NombreB = string.Join(" / ", p.CompetidorB.CompetidorIntegrantes.Select(ci => ci.Atleta.Nombre)),
            CanchaNumero = p.Cancha?.Numero
        }).ToList();
    }

    private async Task IrACategoria(int categoriaId)
    {
        categoriaSeleccionadaId = categoriaId;
        await CargarBracket();
    }

    private async Task CargarBracket()
    {
        mensaje = "";
        propuestaEliminatoria = null;
        partidoCapturandoId = null;
        rondaEnfocada.Clear();

        if (categoriaSeleccionadaId == 0) { bracket = null; return; }

        bracket = await FaseFinalSvc.ObtenerBracketAsync(categoriaSeleccionadaId);

        using var db = await DbFactory.CreateDbContextAsync();
        var config = await db.Configuracions.FirstOrDefaultAsync(c => c.CategoriaId == categoriaSeleccionadaId);
        modalidadSets = config?.ModalidadSetsFinal ?? config?.ModalidadSets ?? "2 de 3 Sets";
        puntosJuego = config?.PuntosJuegoFinal ?? config?.PuntosJuego ?? 21;
        puntosLimite = config?.PuntosLimiteFinal ?? config?.PuntosLimite ?? 30;

        hayPuntosRanking = null;
        competidoresParaSembrado = null;
        sembradosManualSeleccion.Clear();

        hayPuntosRanking = null;
        competidoresParaSembrado = null;
        sembradosManualSeleccion.Clear();

        if (CategoriaSeleccionada?.Formato == "Eliminatoria")
        {
            cantidadSembradosConfigurada = config?.CantidadSembrados ?? 0;
            competidoresParaSembrado = await FaseFinalSvc.ObtenerCompetidoresParaSembradoAsync(categoriaSeleccionadaId);

            if (cantidadSembradosConfigurada > 0 && competidoresParaSembrado.Count >= cantidadSembradosConfigurada)
            {
                hayPuntosRanking = await FaseFinalSvc.HayPuntosDeRankingAsync(categoriaSeleccionadaId);
                if (hayPuntosRanking == false)
                {
                    sembradosManualSeleccion = Enumerable.Repeat(0, cantidadSembradosConfigurada).ToList();
                }
            }
        }
    }

    private Dictionary<int, int> CalcularSeeds(List<LlaveItem> itemsRonda0)
    {
        var dict = new Dictionary<int, int>();
        foreach (var item in itemsRonda0)
        {
            if (item.Partido != null)
            {
                if (item.Partido.CompetidorA.NumeroSembrado != null)
                    dict[item.Partido.CompetidorAid] = item.Partido.CompetidorA.NumeroSembrado.Value;
                if (item.Partido.CompetidorB.NumeroSembrado != null)
                    dict[item.Partido.CompetidorBid] = item.Partido.CompetidorB.NumeroSembrado.Value;
            }
            else if (item.CompetidorConBye?.NumeroSembrado != null)
            {
                dict[item.CompetidorConBye.Id] = item.CompetidorConBye.NumeroSembrado.Value;
            }
        }
        return dict;
    }

    private static int PosicionVisual(int posicionReal, int totalPosiciones)
    {
        if (totalPosiciones <= 1) return 0;
        int mitad = totalPosiciones / 2;
        if (posicionReal < mitad)
            return PosicionVisual(posicionReal, mitad);

        int posEnMitadInferior = posicionReal - mitad;
        return totalPosiciones - 1 - PosicionVisual(posEnMitadInferior, mitad);
    }

    private static string EtiquetaSembrado(int numero) => numero switch
    {
        1 => "1",
        2 => "2",
        3 or 4 => "3/4",
        >= 5 and <= 8 => "5/8",
        >= 9 and <= 16 => "9/16",
        _ => numero.ToString()
    };

    private bool MostrarSembrado(int numeroSeed)
    {
        if (CategoriaSeleccionada?.Formato != "Eliminatoria") return true;
        return numeroSeed <= cantidadSembradosConfigurada;
    }

