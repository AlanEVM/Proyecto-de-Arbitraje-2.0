    private async Task SortearEmpates(List<PosicionFila> tabla, int? noUsado)
    {
        var gruposEmpatados = tabla
            .GroupBy(f => (f.Pg, f.Ds, f.Dp))
            .Where(g => g.Count() > 1)
            .ToList();

        if (!gruposEmpatados.Any()) return;

        using var db = await DbFactory.CreateDbContextAsync();
        var rnd = new Random();

        foreach (var grupoEmpatado in gruposEmpatados)
        {
            var idsEmpatados = grupoEmpatado.Select(f => f.CompetidorId).ToList();
            var valoresAleatorios = Enumerable.Range(1, idsEmpatados.Count).OrderBy(_ => rnd.Next()).ToList();

            var competidoresDb = await db.Competidores.Where(c => idsEmpatados.Contains(c.Id)).ToListAsync();
            for (int i = 0; i < idsEmpatados.Count; i++)
                competidoresDb.First(c => c.Id == idsEmpatados[i]).OrdenDesempate = valoresAleatorios[i];
        }

        await db.SaveChangesAsync();
        await CargarPosiciones();
    }

