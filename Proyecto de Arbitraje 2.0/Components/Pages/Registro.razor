        _ => generoElegido ?? ""
    };

    private static string TextoGenero(string? g) => g == "M" ? "Hombre" : g == "F" ? "Mujer" : "(sin definir)";

    private string NombreMunicipio(int id) => municipios?.FirstOrDefault(m => m.Id == id)?.Nombre ?? "(sin definir)";

    // Todos los campos de un atleta NUEVO son obligatorios. Devuelve el error, o null si todo está bien.
    private string? ValidarDatosAtletaNuevo(string quien, string nombre, int municipioId, string genero, int? anio)
    {
        if (string.IsNullOrWhiteSpace(nombre)) return $"{quien}: escribe el nombre completo.";
        if (municipioId == 0) return $"{quien}: selecciona el municipio.";
        if (string.IsNullOrEmpty(genero)) return $"{quien}: selecciona el género.";
        if (anio == null) return $"{quien}: indica el año de nacimiento.";
        if (anio < DateTime.Now.Year - 99 || anio > DateTime.Now.Year)
            return $"{quien}: el año de nacimiento debe estar entre {DateTime.Now.Year - 99} y {DateTime.Now.Year}.";
        return null;
    }

    private string ResumenAtletaNuevo(string titulo, string nombre, int municipioId, string genero, int? anio) =>
        $"{titulo}:\n  Nombre: {nombre}\n  Municipio: {NombreMunicipio(municipioId)}\n  Género: {TextoGenero(genero)}\n  Año de nacimiento: {anio}";

    private string? ValidarIntegranteNuevo(IntegranteFormulario i, string quien)
    {
        if (!i.EsNuevo)
            return i.AtletaExistenteId == 0 ? $"{quien}: selecciona un atleta existente." : null;

        return ValidarDatosAtletaNuevo(quien, i.NuevoNombre, i.NuevoMunicipioId, GeneroPorRama(i.NuevoGenero), i.AnioNacimiento);
    }

    private string ResumenIntegrante(string titulo, IntegranteFormulario i)
    {
        if (!i.EsNuevo)
        {
            var a = atletasDisponibles?.FirstOrDefault(x => x.Id == i.AtletaExistenteId);
            return a == null
                ? $"{titulo}: (no encontrado)"
                : $"{titulo} (YA REGISTRADO):\n  Nombre: {a.Nombre}\n  Municipio: {a.Municipio?.Nombre}\n  Género: {TextoGenero(a.Genero)}\n  Año de nacimiento: {a.AnioNacimiento?.ToString() ?? "(sin definir)"}";
        }

        return ResumenAtletaNuevo($"{titulo} (NUEVO)", i.NuevoNombre.Trim(), i.NuevoMunicipioId, GeneroPorRama(i.NuevoGenero), i.AnioNacimiento)
            + AvisoParecidas(i.NuevoNombre.Trim());
    }

    private static string NormalizarNombre(string s)
    {
        var descompuesto = s.Trim().ToLowerInvariant().Normalize(System.Text.NormalizationForm.FormD);
        var sb = new System.Text.StringBuilder();
        foreach (var c in descompuesto)
            if (System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c) != System.Globalization.UnicodeCategory.NonSpacingMark)
                sb.Append(c);
        return string.Join(' ', sb.ToString().Split(' ', StringSplitOptions.RemoveEmptyEntries));
    }

    // Distancia de edición (cuántas letras hay que cambiar para pasar de un texto a otro)
    private static int Distancia(string a, string b)
    {
        var prev = new int[b.Length + 1];
        var curr = new int[b.Length + 1];
        for (int j = 0; j <= b.Length; j++) prev[j] = j;

        for (int i = 1; i <= a.Length; i++)
        {
            curr[0] = i;
            for (int j = 1; j <= b.Length; j++)
            {
                int costo = a[i - 1] == b[j - 1] ? 0 : 1;
                curr[j] = Math.Min(Math.Min(curr[j - 1] + 1, prev[j] + 1), prev[j - 1] + costo);
            }
            (prev, curr) = (curr, prev);
        }
        return prev[b.Length];
    }

    private List<Atleta> BuscarAtletasParecidas(string nombreNuevo)
    {
        var nuevo = NormalizarNombre(nombreNuevo);
        if (nuevo.Length == 0) return new();
        var tokensNuevo = nuevo.Split(' ').Where(t => t.Length >= 3).ToArray();

        return (atletasDisponibles ?? new List<Atleta>())
            .Select(a =>
            {
                var existente = NormalizarNombre(a.Nombre);
                var tokensExistente = existente.Split(' ');
                int distancia = Distancia(nuevo, existente);
                int compartidos = tokensNuevo.Count(t => tokensExistente.Any(e => Distancia(t, e) <= (t.Length >= 5 ? 1 : 0)));

                bool casiIgual = distancia <= Math.Max(2, nuevo.Length / 6);
                bool comparteVarios = compartidos >= 2 || (tokensNuevo.Length == 1 && compartidos == 1);
                return (a, distancia, parecida: casiIgual || comparteVarios);
            })
            .Where(x => x.parecida)
            .OrderBy(x => x.distancia)
            .Take(5)
            .Select(x => x.a)
            .ToList();
    }

    private string AvisoParecidas(string nombre)
    {
        var parecidas = BuscarAtletasParecidas(nombre);
        if (parecidas.Count == 0) return "";

        return "\n\nATENCIÓN: ya existen atletas con nombre parecido:\n" +
               string.Join("\n", parecidas.Select(a => $"  • {a.Nombre} — {a.Municipio?.Nombre} — {(a.AnioNacimiento?.ToString() ?? "sin año")}")) +
               "\nSi es la misma persona, cancela y elige \"Atleta ya registrado\".";
    }

    private async Task RegistrarAtleta()
    {
        if (categoriaActiva?.RegistroCerrado == true) {  mensajeError = "El registro de esta categoría está cerrado."; return; }

        mensajeError = ""; mensajeExito = "";

        using var db = await DbFactory.CreateDbContextAsync();
        Atleta atleta;

        if (!atletaSingleEsNuevo)
        {
            if (atletaSingleExistenteId == 0) { mensajeError = "Selecciona un atleta existente."; return; }

            var atletaExistente = atletasDisponibles!.FirstOrDefault(a => a.Id == atletaSingleExistenteId);
            if (atletaExistente == null) { mensajeError = "Atleta no encontrado."; return; }

            if (categoriaActiva!.Rama == "Varonil" && atletaExistente.Genero != "M") { mensajeError = "Esta categoría es Varonil."; return; }
            if (categoriaActiva.Rama == "Femenil" && atletaExistente.Genero != "F") { mensajeError = "Esta categoría es Femenil."; return; }

            var aniosPermitidos = AniosPermitidos();
            if (aniosPermitidos != null && (atletaExistente.AnioNacimiento == null || !aniosPermitidos.Contains(atletaExistente.AnioNacimiento.Value)))
            {
                mensajeError = $"Esta categoría solo admite nacidos entre {aniosPermitidos.Min()} y {aniosPermitidos.Max()}.";
                return;
            }

            bool confirmaExistente = await JS.InvokeAsync<bool>("confirm",
                $"¿Seguro que quieres agregar a este atleta a la categoría '{categoriaActiva.Nombre}' ({categoriaActiva.Modalidad} {categoriaActiva.Rama}) del torneo '{TorneoActual.NombreTorneo}'?\n\n" +
                $"  Nombre: {atletaExistente.Nombre}\n" +
                $"  Municipio: {atletaExistente.Municipio?.Nombre}\n" +
                $"  Género: {TextoGenero(atletaExistente.Genero)}\n" +
                $"  Año de nacimiento: {atletaExistente.AnioNacimiento?.ToString() ?? "(sin definir)"}");
            if (!confirmaExistente) return;

            atleta = atletaExistente;
        }
        else
        {
            var errorCampos = ValidarDatosAtletaNuevo("Atleta", nuevoNombreAtleta, municipioSeleccionadoId, GeneroPorRama(generoSeleccionado), anioNacimientoNuevo);
            if (errorCampos != null) { mensajeError = errorCampos; return; }
            if (categoriaActiva!.Rama == "Varonil" && generoSeleccionado == "F") { mensajeError = "Esta categoría es Varonil."; return; }
            if (categoriaActiva.Rama == "Femenil" && generoSeleccionado == "M") { mensajeError = "Esta categoría es Femenil."; return; }

            var aniosPermitidosNuevo = AniosPermitidos();
            if (aniosPermitidosNuevo != null && (anioNacimientoNuevo == null || !aniosPermitidosNuevo.Contains(anioNacimientoNuevo.Value)))
            {
                mensajeError = $"Esta categoría solo admite nacidos entre {aniosPermitidosNuevo.Min()} y {aniosPermitidosNuevo.Max()}.";
                return;
            }

            string resumen = ResumenAtletaNuevo("Atleta NUEVO", nuevoNombreAtleta.Trim(), municipioSeleccionadoId, GeneroPorRama(generoSeleccionado), anioNacimientoNuevo)
                            + AvisoParecidas(nuevoNombreAtleta.Trim());
            bool datosCorrectos = await JS.InvokeAsync<bool>("confirm",
                $"Vas a registrar un atleta NUEVO en '{categoriaActiva.Nombre}' del torneo '{TorneoActual.NombreTorneo}':\n\n{resumen}\n\n" +
                "¿Los datos son correctos?\n(Si esta persona ya estaba registrada, cancela y usa \"Atleta ya registrado\" para no duplicarla.)");
            if (!datosCorrectos) return;

            string nombreFinalAtleta = nuevoNombreAtleta.Trim();
            string? generoFinalAtleta = string.IsNullOrEmpty(generoSeleccionado) ? null : generoSeleccionado;

            var existente = await db.Atletas.FirstOrDefaultAsync(a =>
                a.Nombre == nombreFinalAtleta && a.MunicipioId == municipioSeleccionadoId && a.AnioNacimiento == anioNacimientoNuevo);

            if (existente == null)
            {
                atleta = new Atleta
                    {
                        Nombre = nombreFinalAtleta,
                        MunicipioId = municipioSeleccionadoId,
                        Genero = generoFinalAtleta,
                        AnioNacimiento = anioNacimientoNuevo
                    };
                db.Atletas.Add(atleta);

                try { await db.SaveChangesAsync(); }
                catch (DbUpdateException) { mensajeError = "No se pudo registrar el atleta. Revisa el año de nacimiento."; return; }
            }
            else
            {
                // Nombre + Municipio + Año de nacimiento, los 3 exactamente
                // iguales, ya es mucha casualidad -- probablemente es la
                // misma persona, pero preguntamos para estar seguros, ya
                // que si nos equivocamos aquí se mezclaría mal el ranking.
                bool esLaMisma = await JS.InvokeAsync<bool>("confirm",
                    $"Ya existe un atleta llamado '{existente.Nombre}' del mismo municipio y año de nacimiento. ¿Es la misma persona?");

                if (esLaMisma)
                {
                    if (existente.Genero != generoFinalAtleta)
                    {
                        existente.Genero = generoFinalAtleta;
                        await db.SaveChangesAsync();
                    }
                    atleta = existente;
                }
                else
                {
                    string? diferenciador = await JS.InvokeAsync<string?>("prompt",
                        "Son personas distintas. Escribe algo para diferenciarlas en el sistema (ej. un apodo, o el nombre de un padre/tutor):");

                    if (string.IsNullOrWhiteSpace(diferenciador))
                    {
                        mensajeError = "Necesitas escribir un diferenciador para poder registrar a esta segunda persona.";
                        return;
                    }

                    nombreFinalAtleta = $"{nombreFinalAtleta} ({diferenciador.Trim()})";

                    atleta = new Atleta
                        {
                            Nombre = nombreFinalAtleta,
                            MunicipioId = municipioSeleccionadoId,
                            Genero = generoFinalAtleta,
                            AnioNacimiento = anioNacimientoNuevo
                        };
                    db.Atletas.Add(atleta);

                    try { await db.SaveChangesAsync(); }
                    catch (DbUpdateException) { mensajeError = "No se pudo registrar el atleta. Revisa el año de nacimiento."; return; }
                }
            }
        }

        int? grupoId = categoriaActiva!.Formato == "GruposFaseFinal"
            ? await ElegirGrupoBalanceadoAsync(db, categoriaActiva, 0)
            : null;

        var competidor = new Competidore
        {
            CategoriaId = categoriaActiva.Id,
            Activo = true,
            GrupoId = grupoId
        };
        competidor.CompetidorIntegrantes.Add(new CompetidorIntegrante { AtletaId = atleta.Id });
        db.Competidores.Add(competidor);

        try { await db.SaveChangesAsync(); }
        catch (DbUpdateException) { mensajeError = "Este atleta ya está registrado en esta misma categoría."; return; }

        nuevoNombreAtleta = "";
        anioNacimientoNuevo = null;
        atletaSingleExistenteId = 0;   // solo se limpia la selección; se conserva el modo (nuevo/existente) y los filtros
        mensajeExito = "¡Atleta registrado!";

        atletasDisponibles = await db.Atletas.Include(a => a.Municipio).OrderBy(a => a.Nombre).ToListAsync();
        await CargarCompetidores();
        await CargarAtletasYaRegistrados();
        if (categoriaActiva.Formato == "GruposFaseFinal") await CargarGrupos();
    }

    private async Task RegistrarPareja()
    {
        if (categoriaActiva?.RegistroCerrado == true) {  mensajeError = "El registro de esta categoría está cerrado."; return; }

        mensajeError = ""; mensajeExito = "";

        using var db = await DbFactory.CreateDbContextAsync();

        // Validar campos de los integrantes ANTES de crear a nadie en la base
        var errorCampos = ValidarIntegranteNuevo(integrante1, "Integrante 1") ?? ValidarIntegranteNuevo(integrante2, "Integrante 2");
        if (errorCampos != null) { mensajeError = errorCampos; return; }

        bool datosCorrectos = await JS.InvokeAsync<bool>("confirm",
            $"Vas a registrar esta pareja en '{categoriaActiva!.Nombre}' del torneo '{TorneoActual.NombreTorneo}':\n\n" +
            $"{ResumenIntegrante("Integrante 1", integrante1)}\n\n" +
            $"{ResumenIntegrante("Integrante 2", integrante2)}\n\n" +
            "¿Los datos son correctos?");
        if (!datosCorrectos) return;

        var (atleta1, error1) = await ResolverAtleta(db, integrante1);
        if (error1 != null) { mensajeError = error1; return; }

        var (atleta2, error2) = await ResolverAtleta(db, integrante2);
        if (error2 != null) { mensajeError = error2; return; }

        if (atleta1!.Id == atleta2!.Id) { mensajeError = "Los dos integrantes no pueden ser la misma persona."; return; }
        if (atleta1.MunicipioId != atleta2.MunicipioId) { mensajeError = "Los dos integrantes deben ser del mismo municipio/equipo."; return; }

        if (categoriaActiva!.Rama == "Varonil" && (atleta1.Genero != "M" || atleta2.Genero != "M")) { mensajeError = "Ambos deben ser 'M'."; return; }
        if (categoriaActiva.Rama == "Femenil" && (atleta1.Genero != "F" || atleta2.Genero != "F")) { mensajeError = "Ambas deben ser 'F'."; return; }
        if (categoriaActiva.Rama == "Mixto")
        {
            var generos = new[] { atleta1.Genero, atleta2.Genero };
            if (string.IsNullOrEmpty(atleta1.Genero) || string.IsNullOrEmpty(atleta2.Genero)) { mensajeError = "Ambos deben tener género definido."; return; }
            if (!(generos.Contains("M") && generos.Contains("F"))) { mensajeError = "Debe ser 1 hombre y 1 mujer."; return; }
        }

        int? grupoId = categoriaActiva.Formato == "GruposFaseFinal"
            ? await ElegirGrupoBalanceadoAsync(db, categoriaActiva, 0)
            : null;

        var competidor = new Competidore
        {
            CategoriaId = categoriaActiva.Id,
            Activo = true,
            GrupoId = grupoId
        };
        competidor.CompetidorIntegrantes.Add(new CompetidorIntegrante { AtletaId = atleta1.Id });
        competidor.CompetidorIntegrantes.Add(new CompetidorIntegrante { AtletaId = atleta2.Id });
        db.Competidores.Add(competidor);

        try { await db.SaveChangesAsync(); }
        catch (DbUpdateException) { mensajeError = "Uno de los dos atletas ya está registrado en esta misma categoría."; return; }

        integrante1 = new() { EsNuevo = integrante1.EsNuevo, FiltroAnio = integrante1.FiltroAnio, FiltroMunicipioId = integrante1.FiltroMunicipioId };
        integrante2 = new() { EsNuevo = integrante2.EsNuevo, FiltroAnio = integrante2.FiltroAnio, FiltroMunicipioId = integrante2.FiltroMunicipioId };
        mensajeExito = "¡Pareja registrada!";

        atletasDisponibles = await db.Atletas.Include(a => a.Municipio).OrderBy(a => a.Nombre).ToListAsync();
        await CargarCompetidores();
        await CargarAtletasYaRegistrados();
        if (categoriaActiva.Formato == "GruposFaseFinal") await CargarGrupos();
    }

    private async Task<(Atleta? atleta, string? error)> ResolverAtleta(TorneoContext db, IntegranteFormulario integrante)
    {
        var aniosPermitidos = AniosPermitidos();

        if (!integrante.EsNuevo)
        {
            if (integrante.AtletaExistenteId == 0) return (null, "Selecciona un atleta existente para ambos integrantes.");
            var atleta = atletasDisponibles!.First(a => a.Id == integrante.AtletaExistenteId);

            if (aniosPermitidos != null && (atleta.AnioNacimiento == null || !aniosPermitidos.Contains(atleta.AnioNacimiento.Value)))
                return (null, $"Esta categoría solo admite nacidos entre {aniosPermitidos.Min()} y {aniosPermitidos.Max()}.");

            return (atleta, null);
        }

        if (string.IsNullOrWhiteSpace(integrante.NuevoNombre)) return (null, "Ponle nombre a ambos integrantes nuevos.");
        if (integrante.NuevoMunicipioId == 0) return (null, "Selecciona municipio para ambos integrantes nuevos.");

        if (aniosPermitidos != null && (integrante.AnioNacimiento == null || !aniosPermitidos.Contains(integrante.AnioNacimiento.Value)))
            return (null, $"Esta categoría solo admite nacidos entre {aniosPermitidos.Min()} y {aniosPermitidos.Max()}.");

        string genero = categoriaActiva!.Rama switch
        {
            "Varonil" => "M",
            "Femenil" => "F",
            _ => integrante.NuevoGenero
        };

        if (categoriaActiva.Rama == "Mixto" && string.IsNullOrEmpty(genero))
            return (null, "Selecciona el género de ambos integrantes nuevos.");

        var existente = await db.Atletas.FirstOrDefaultAsync(a =>
            a.Nombre == integrante.NuevoNombre.Trim() && a.MunicipioId == integrante.NuevoMunicipioId);

        if (existente != null) return (existente, null);

        var nuevo = new Atleta { Nombre = integrante.NuevoNombre.Trim(), MunicipioId = integrante.NuevoMunicipioId, Genero = genero, AnioNacimiento = integrante.AnioNacimiento };
        db.Atletas.Add(nuevo);
        await db.SaveChangesAsync();
        return (nuevo, null);
    }

    private RenderFragment RenderIntegrante(string titulo, IntegranteFormulario integrante, IntegranteFormulario otro) => __builder =>
    {
        int? filtroMunicipioId = null;
        string? nombreMunicipioFiltro = null;

        if (otro.EsNuevo && otro.NuevoMunicipioId != 0)
        {
            filtroMunicipioId = otro.NuevoMunicipioId;
            nombreMunicipioFiltro = municipios?.FirstOrDefault(m => m.Id == otro.NuevoMunicipioId)?.Nombre;
        }
        else if (!otro.EsNuevo && otro.AtletaExistenteId != 0)
        {
            var atletaOtro = atletasDisponibles?.FirstOrDefault(a => a.Id == otro.AtletaExistenteId);
            filtroMunicipioId = atletaOtro?.MunicipioId;
            nombreMunicipioFiltro = atletaOtro?.Municipio?.Nombre;
        }

        var aniosPermitidosPareja = AniosPermitidos(); 

        // El filtro automático (por el otro integrante) tiene prioridad sobre el manual
        int? municipioEfectivo = filtroMunicipioId
    ?? (integrante.FiltroMunicipioId != 0 ? integrante.FiltroMunicipioId : (int?)null);

        // Género del otro integrante (si ya está definido)
        string? generoOtro = null;
        if (otro.EsNuevo)
            generoOtro = string.IsNullOrEmpty(otro.NuevoGenero) ? null : otro.NuevoGenero;
        else if (otro.AtletaExistenteId != 0)
            generoOtro = atletasDisponibles?.FirstOrDefault(a => a.Id == otro.AtletaExistenteId)?.Genero;

        // Género que se le debe mostrar a este integrante
        string? generoRequerido = categoriaActiva!.Rama switch
        {
            "Varonil" => "M",
            "Femenil" => "F",
            "Mixto" => generoOtro == "M" ? "F" : generoOtro == "F" ? "M" : null,
            _ => null
        };

        var listaFiltrada = (atletasDisponibles ?? new List<Atleta>())
            .Where(a => municipioEfectivo == null || a.MunicipioId == municipioEfectivo)
            .Where(a => integrante.FiltroAnio == null || a.AnioNacimiento == integrante.FiltroAnio)
            .Where(a => generoRequerido == null || a.Genero == generoRequerido)
            .Where(a => a.Id != otro.AtletaExistenteId)
            .Where(a => !atletaIdsYaRegistradosEnCategoria.Contains(a.Id))
            .Where(a => aniosPermitidosPareja == null || (a.AnioNacimiento != null && aniosPermitidosPareja.Contains(a.AnioNacimiento.Value)))
            .ToList();

        <div class="subtarjeta">
            <strong>@titulo</strong>

            <div class="radio-grupo">
                <label>
                    <input type="radio" checked="@integrante.EsNuevo" @onchange="() => integrante.EsNuevo = true" />
                    Atleta nuevo
                </label>
                <label>
                    <input type="radio" checked="@(!integrante.EsNuevo)" @onchange="() => integrante.EsNuevo = false" />
                    Atleta ya registrado
                </label>
            </div>

            @if (integrante.EsNuevo)
            {
                <div style="display:flex; gap:10px; align-items:end; flex-wrap:wrap;">
                    <div>
                        <label>Nombre:</label><br />
                        <input @bind="integrante.NuevoNombre" style="width:200px;" />
                    </div>
                    <div>
                        <label>Municipio:</label><br />
                        <select @bind="integrante.NuevoMunicipioId">
                            <option value="0">-- Selecciona --</option>
                            @if (municipios != null)
                            {
                                @foreach (var m in municipios)
                                {
                                    <option value="@m.Id">@m.Nombre</option>
                                }
                            }
                        </select>
                    </div>
                    <div>
                        <label>Género:</label><br />
                        @if (categoriaActiva!.Rama == "Mixto")
                        {
                            <select @bind="integrante.NuevoGenero">
                                <option value="">--</option>
                                <option value="M">M</option>
                                <option value="F">F</option>
                            </select>
                        }
                        else
                        {
                            <input value="@(categoriaActiva.Rama == "Varonil" ? "M" : "F")" disabled style="width:50px; text-align:center; background:#eee;" />
                        }
                    </div>
                    <div>
                        <label>Edad:</label><br />
                        @if (AniosPermitidos() is { } aniosPermitidosDobles)
                        {
                            <select @bind="integrante.AnioNacimiento" style="width:80px;">
                                <option value="">--</option>
                                @foreach (var anio in aniosPermitidosDobles)
                                {
                                    <option value="@anio">@anio</option>
                                }
                            </select>
                        }
                        else
                        {
                            <input type="number" min="@(DateTime.Now.Year - 99)" max="@DateTime.Now.Year" @bind="integrante.AnioNacimiento" style="width:70px;" />
                        }
                    </div>
                </div>
            }
            else
            {
                <div style="display:flex; gap:10px; flex-wrap:wrap; margin-bottom:6px;">
                    @if (aniosPermitidosPareja == null)
                    {
                        <div>
                            <label>Filtrar por año:</label><br />
                            <input type="number" min="@(DateTime.Now.Year - 99)" max="@DateTime.Now.Year"
                                   @bind="integrante.FiltroAnio" placeholder="Todos" style="width:90px;" />
                        </div>
                    }
                    @if (filtroMunicipioId == null)
                    {
                        <div>
                            <label>Filtrar por equipo:</label><br />
                            <select @bind="integrante.FiltroMunicipioId" style="width:200px;">
                                <option value="0">-- Todos --</option>
                                @foreach (var m in municipios!)
                                {
                                    <option value="@m.Id">@m.Nombre</option>
                                }
                            </select>
                        </div>
                    }
                </div>
                <div>
                    <label>Selecciona atleta:</label>
                    @if (categoriaActiva!.Rama == "Mixto" && generoRequerido != null)
                    {
                        <span style="color:#666; font-size:0.9em;"> (mostrando solo @(generoRequerido == "F" ? "mujeres" : "hombres"))</span>
                    }
                    <br />
                    <select @bind="integrante.AtletaExistenteId" style="width:300px;">
                        <option value="0">-- Selecciona --</option>
                        @foreach (var a in listaFiltrada)
                        {
                            <option value="@a.Id">@a.Nombre (@a.Municipio.Nombre) @(a.AnioNacimiento != null ? $" - {a.AnioNacimiento}" : "") @(string.IsNullOrEmpty(a.Genero) ? "" : $"[{a.Genero}]")</option>
                        }
                    </select>

                    @if (filtroMunicipioId != null && !listaFiltrada.Any())
                    {
                        <p style="color:#b00; font-size:0.9em;">No hay más atletas disponibles de ese municipio — registra uno nuevo.</p>
                    }
                </div>
            }
        </div>
    };

    private async Task RecargarCategoriasAsync()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        categorias = await db.Categorias
            .Include(c => c.Configuracion)
            .Where(c => c.TorneoId == TorneoActual.TorneoId)
            .ToListAsync();
    }

    private async Task CerrarRegistro()
    {
        if (categoriaActiva == null) return;

        bool confirmado = await JS.InvokeAsync<bool>("confirm",
            "¿Cerrar el registro de esta categoría? Ya no se podrán agregar, quitar ni mover atletas (solo dar de baja si es necesario), y se generarán automaticamente los partidos que correspondan.");
        if (!confirmado) return;

        var (ok, msg) = await CalendarioSvc.CerrarRegistroAsync(categoriaActiva.Id);

        // Volver a leer la categoría de la BD para que RegistroCerrado quede actualizado
        await RecargarCategoriasAsync();
        await OnCategoriaSeleccionada();

        // Los mensajes se ponen DESPUÉS, porque OnCategoriaSeleccionada los limpia
        mensajeError = ok ? "" : msg;
        mensajeExito = ok ? msg : "";
    }

    private async Task ReabrirRegistro()
    {
        if (categoriaActiva == null) return;

        var (ok, msg) = await CalendarioSvc.ReabrirRegistroAsync(categoriaActiva.Id);

        await RecargarCategoriasAsync();
        await OnCategoriaSeleccionada();

        mensajeError = ok ? "" : msg;
        mensajeExito = ok ? msg : "";
    }

    private async Task DarDeBaja(int competidorId, string nombre)
    {
        bool confirmado = await JS.InvokeAsync<bool>("confirm", $"¿Dar de baja a {nombre}?");
        if (!confirmado) return;

        mensajeError = ""; mensajeExito= "";
        var (ok, msg, _) = await CalendarioSvc.DarDeBajaCompetidorAsync(competidorId);
        if (ok) mensajeExito = msg; else mensajeError = msg;
        await CargarCompetidores();
    }

    private async Task EliminarCompetidor(int competidorId, string nombre)
    {
        if (categoriaActiva?.RegistroCerrado == true) { mensajeError = "El registro de esta categoría está cerrado."; return; }

        bool confirmado = await JS.InvokeAsync<bool>("confirm",
            $"¿Eliminar a {nombre} de esta categoría?\n\n" +
            "Si no está registrado en ninguna otra categoría ni torneo (ni tiene ranking), también se eliminará del catálogo de atletas. " +
            "Si sí lo está, solo se quita de esta categoría y sus demás datos se conservan.\n\n" +
            "Esta acción no se puede deshacer.");
        if (!confirmado) return;

        mensajeError = ""; mensajeExito = "";
        using var db = await DbFactory.CreateDbContextAsync();

        bool activo = await db.Partidos.AnyAsync(p =>
            (p.CompetidorAid == competidorId || p.CompetidorBid == competidorId) &&
            (p.Estado == "Jugado" || p.Estado == "EnCancha"));

        if (activo) { mensajeError = "Este atleta ya tiene partidos jugados o en curso. No se puede eliminar."; return; }

        // Atletas de este competidor (1 en singles, 2 en dobles), antes de quitar el enlace
        var atletaIds = await db.CompetidorIntegrantes
            .Where(ci => ci.CompetidorId == competidorId)
            .Select(ci => ci.AtletaId)
            .ToListAsync();

        try
        {
            db.Partidos.RemoveRange(db.Partidos.Where(p => p.CompetidorAid == competidorId || p.CompetidorBid == competidorId));
            db.CompetidorIntegrantes.RemoveRange(db.CompetidorIntegrantes.Where(ci => ci.CompetidorId == competidorId));
            db.ByesFaseFinal.RemoveRange(db.ByesFaseFinal.Where(b => b.CompetidorId == competidorId));

            var competidor = await db.Competidores.FindAsync(competidorId);
            if (competidor != null) db.Competidores.Remove(competidor);

            await db.SaveChangesAsync();
        }
        catch (DbUpdateException)
        {
            mensajeError = "No se pudo eliminar: este atleta sigue referenciado en la fase final (por ejemplo, un bye). Revisa la categoría.";
            return;
        }

        // Borrar del catálogo a quien ya no está registrado en ningún otro lado
        int eliminadosDelCatalogo = 0;
        foreach (var atletaId in atletaIds)
        {
            bool sigueEnOtroLado =
                await db.CompetidorIntegrantes.AnyAsync(ci => ci.AtletaId == atletaId) ||
                await db.RankingHistorials.AnyAsync(r => r.AtletaId == atletaId) ||
                await db.PuntosPartido.AnyAsync(pp => pp.SirveAtletaId == atletaId || pp.RecibeAtletaId == atletaId);

            if (sigueEnOtroLado) continue;

            try
            {
                var atleta = await db.Atletas.FindAsync(atletaId);
                if (atleta != null)
                {
                    db.Atletas.Remove(atleta);
                    await db.SaveChangesAsync();
                    eliminadosDelCatalogo++;
                }
            }
            catch (DbUpdateException)
            {
                db.ChangeTracker.Clear();   // si algo todavía la referencia, simplemente se conserva
            }
        }

        mensajeExito = eliminadosDelCatalogo == 0
            ? "Eliminado de esta categoría. Sus datos se conservan porque está registrado en otra categoría o torneo."
            : eliminadosDelCatalogo == atletaIds.Count
                ? "Eliminado por completo: no estaba registrado en ninguna otra categoría ni torneo."
                : "Eliminados de esta categoría. Solo se borró del catálogo a quien no estaba en ningún otro lado; el otro integrante se conserva.";

        // Refrescar la lista del selector "Atleta ya registrado" para que no aparezcan borrados
        atletasDisponibles = await db.Atletas.Include(a => a.Municipio).OrderBy(a => a.Nombre).ToListAsync();
        await CargarCompetidores();
        await CargarAtletasYaRegistrados();
        await CargarGrupos();
    }

    // Borra del catálogo a las atletas que ya no están registradas en ningún otro lado.
    // Devuelve cuántas se eliminaron y cuántas se conservaron.
    private static async Task<(int eliminados, int conservados)> LimpiarAtletasSueltasAsync(TorneoContext db, IEnumerable<int> atletaIds)
    {
        int eliminados = 0, conservados = 0;

        foreach (var atletaId in atletaIds.Distinct())
        {
            bool sigueEnOtroLado =
                await db.CompetidorIntegrantes.AnyAsync(ci => ci.AtletaId == atletaId) ||
                await db.RankingHistorials.AnyAsync(r => r.AtletaId == atletaId) ||
                await db.PuntosPartido.AnyAsync(pp => pp.SirveAtletaId == atletaId || pp.RecibeAtletaId == atletaId);

            if (sigueEnOtroLado) { conservados++; continue; }

            try
            {
                var atleta = await db.Atletas.FindAsync(atletaId);
                if (atleta != null)
                {
                    db.Atletas.Remove(atleta);
                    await db.SaveChangesAsync();
                    eliminados++;
                }
            }
            catch (DbUpdateException)
            {
                db.ChangeTracker.Clear();   // si algo todavía la referencia, se conserva
                conservados++;
            }
        }

        return (eliminados, conservados);
    }

    private async Task EliminarCategoriaActiva()
    {
        if (categoriaActiva?.RegistroCerrado == true) {  mensajeError = "El registro de esta categoría está cerrado."; return; }

        mensajeError = ""; mensajeExito = "";

        bool confirmado = await JS.InvokeAsync<bool>("confirm",
            $"¿Eliminar la categoría '{categoriaActiva!.Nombre} {categoriaActiva.Modalidad} {categoriaActiva.Rama}' por completo?\n\n" +
            "Se borrarán sus partidos y sus inscripciones. Los atletas que no estén registrados en ninguna otra categoría ni torneo " +
            "(ni tengan ranking) también se eliminarán del catálogo; los demás se conservan con todos sus datos.\n\n" +
            "Esta acción no se puede deshacer.");
        if (!confirmado) return;

        using var db = await DbFactory.CreateDbContextAsync();
        using var transaccion = await db.Database.BeginTransactionAsync();

        var atletaIds = new List<int>();

        try
        {
            var competidorIds = await db.Competidores.Where(c => c.CategoriaId == categoriaActiva.Id).Select(c => c.Id).ToListAsync();

            atletaIds = await db.CompetidorIntegrantes
                .Where(ci => competidorIds.Contains(ci.CompetidorId))
                .Select(ci => ci.AtletaId)
                .Distinct()
                .ToListAsync();

            var partidoIds = await db.Partidos.Where(p => p.CategoriaId == categoriaActiva.Id).Select(p => p.Id).ToListAsync();

            var puntosABorrar = await db.PuntosPartido.Where(pp => partidoIds.Contains(pp.PartidoId)).ToListAsync();
            db.PuntosPartido.RemoveRange(puntosABorrar);

            var setsABorrar = await db.SetsPartidos.Where(s => partidoIds.Contains(s.PartidoId)).ToListAsync();
            db.SetsPartidos.RemoveRange(setsABorrar);

            var byesABorrar = await db.ByesFaseFinal.Where(b => b.CategoriaId == categoriaActiva.Id).ToListAsync();
            db.ByesFaseFinal.RemoveRange(byesABorrar);

            var partidosABorrar = await db.Partidos.Where(p => p.CategoriaId == categoriaActiva.Id).ToListAsync();
            db.Partidos.RemoveRange(partidosABorrar);

            var integrantesABorrar = await db.CompetidorIntegrantes.Where(ci => competidorIds.Contains(ci.CompetidorId)).ToListAsync();
            db.CompetidorIntegrantes.RemoveRange(integrantesABorrar);

            var competidoresABorrar = await db.Competidores.Where(c => c.CategoriaId == categoriaActiva.Id).ToListAsync();
            db.Competidores.RemoveRange(competidoresABorrar);

            var rankingABorrar = await db.RankingHistorials.Where(r => r.CategoriaId == categoriaActiva.Id).ToListAsync();
            db.RankingHistorials.RemoveRange(rankingABorrar);

            var gruposABorrar = await db.Grupos.Where(g => g.CategoriaId == categoriaActiva.Id).ToListAsync();
            db.Grupos.RemoveRange(gruposABorrar);

            await db.SaveChangesAsync();

            var cat = await db.Categorias.FindAsync(categoriaActiva.Id);
            if (cat != null) db.Categorias.Remove(cat);
            await db.SaveChangesAsync();

            await transaccion.CommitAsync();
        }
        catch
        {
            await transaccion.RollbackAsync();
            mensajeError = "Ocurrió un error al eliminar la categoría. No se borró nada.";
            return;
        }

        var (atletasEliminadas, atletasConservadas) = await LimpiarAtletasSueltasAsync(db, atletaIds);

        categoriaSeleccionadaId = 0;
        categoriaActiva = null;
        competidoresActuales = null;
        categorias = await db.Categorias.Include(c => c.Configuracion).Where(c => c.TorneoId == TorneoActual.TorneoId).ToListAsync();
        mensajeExito = "Categoría eliminada."
            + (atletasEliminadas > 0 ? $" {atletasEliminadas} atleta(s) que no estaban en ningún otro lado también se eliminaron del catálogo." : "")
            + (atletasConservadas > 0 ? $" {atletasConservadas} se conservan por estar registrados en otra categoría o torneo." : "");

        // Refrescar la lista de "Atleta ya registrado" para que no aparezcan las eliminadas
        atletasDisponibles = await db.Atletas.Include(a => a.Municipio).OrderBy(a => a.Nombre).ToListAsync();
    }
}