@page "/respaldo"
@attribute [Authorize(Roles = "Admin")]
@using Microsoft.AspNetCore.Authorization
@using ProyectoArbitraje.Data
@using ProyectoArbitraje.Models
@using Microsoft.EntityFrameworkCore
@using Microsoft.Data.SqlClient
@inject IDbContextFactory<TorneoContext> DbFactory
@inject IConfiguration Config
@inject IJSRuntime JS

<PageTitle>Respaldo</PageTitle>

<div class="pagina">
    <div class="tarjeta-marcador pagina-header">
        <h1>Respaldo de Base de Datos</h1>
        <p class="pagina-subtitulo">Guarda una copia completa de toda la base de datos (todos los torneos) en Amazon S3.</p>
    </div>

    <div class="tarjeta">
        <h2>Hacer respaldo</h2>
        <p class="nota">Los respaldos se guardan en el bucket S3 configurado en el servidor. Crear uno toma solo un segundo en iniciarse, pero AWS tarda unos minutos en completarlo en segundo plano.</p>

        <div style="margin-top:16px; display:flex; gap:10px;">
            <button class="btn btn-primary" @onclick="HacerRespaldo">Respaldar Ahora</button>
            <button class="btn btn-ghost" @onclick="ActualizarEstados">Actualizar estado</button>
        </div>

        @if (!string.IsNullOrEmpty(mensaje))
        {
            <p class="@(esExito ? "mensaje-exito" : "mensaje-error")">@mensaje</p>
        }

        <table class="tabla" style="margin-top:20px;">
            <thead>
                <tr>
                    <th>Archivo</th>
                    <th>Fecha solicitado</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @if (!respaldos.Any())
                {
                    <tr><td colspan="3" class="vacio">Todavía no se ha hecho ningún respaldo.</td></tr>
                }
                else
                {
                    @foreach (var r in respaldos)
                    {
                        <tr>
                            <td>@r.NombreArchivo</td>
                            <td>@r.FechaSolicitado.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@r.Estado</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="tarjeta">
        <h2>Restaurar Respaldo</h2>
        <p class="mensaje-error" style="font-weight:600;">
            Esto reemplaza TODOS los datos actuales (de todos los torneos) por los del respaldo elegido. No se puede deshacer, y desconecta a todos los que estén usando la app en este momento. AWS tarda unos minutos en completar la restauración; usa "Actualizar estado" arriba para saber cuándo terminó, y hasta entonces cierra y vuelve a abrir la aplicación.
        </p>

        @{
            var completos = respaldos.Where(r => r.Estado == "COMPLETO").ToList();
        }

        @if (!completos.Any())
        {
            <p class="vacio">Todavía no hay ningún respaldo completo disponible para restaurar.</p>
        }
        else
        {
            <div class="campo" style="max-width:420px;">
                <label>Archivo a restaurar</label>
                <select @bind="archivoSeleccionadoId">
                    <option value="0">-- Selecciona un respaldo --</option>
                    @foreach (var r in completos)
                    {
                        <option value="@r.Id">@r.NombreArchivo (@r.FechaSolicitado.ToString("dd/MM/yyyy HH:mm"))</option>
                    }
                </select>
            </div>

            <div class="campo" style="max-width:420px;">
                <label>Escribe RESTAURAR para confirmar</label>
                <input type="text" @bind="textoConfirmacion" placeholder="RESTAURAR" />
            </div>

            <button class="btn btn-primary" @onclick="RestaurarRespaldo">Restaurar</button>
        }

        @if (!string.IsNullOrEmpty(mensajeRestaurar))
        {
            <p class="@(esExitoRestaurar ? "mensaje-exito" : "mensaje-error")">@mensajeRestaurar</p>
        }
    </div>
</div>

@code {
    private string mensaje = "";
    private bool esExito = false;
    private string bucketS3 = "";

    private List<RespaldoS3> respaldos = new();
    private int archivoSeleccionadoId = 0;
    private string textoConfirmacion = "";
    private string mensajeRestaurar = "";
    private bool esExitoRestaurar = false;

    protected override async Task OnInitializedAsync()
    {
        bucketS3 = Config["Respaldos:BucketS3"] ?? "";
        await CargarRespaldos();
    }

    private async Task CargarRespaldos()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        respaldos = await db.RespaldosS3.OrderByDescending(r => r.FechaSolicitado).ToListAsync();
    }

    private async Task HacerRespaldo()
    {
        mensaje = "";
        try
        {
            string nombreArchivo = $"TorneoBadminton_{DateTime.Now:yyyyMMdd_HHmmss}.bak";
            string arn = $"arn:aws:s3:::{bucketS3}/{nombreArchivo}";

            using var conn = new SqlConnection(Config.GetConnectionString("TorneoBadminton"));
            await conn.OpenAsync();
            using (var cmd = conn.CreateCommand())
            {
                cmd.CommandTimeout = 60;
                cmd.CommandText = "EXEC msdb.dbo.rds_backup_database @source_db_name=@db, @s3_arn_to_backup_to=@arn, @overwrite_S3_backup_file=1;";
                cmd.Parameters.AddWithValue("@db", "TorneoBadminton");
                cmd.Parameters.AddWithValue("@arn", arn);
                await cmd.ExecuteNonQueryAsync();
            }

            using var db = await DbFactory.CreateDbContextAsync();
            db.RespaldosS3.Add(new RespaldoS3
            {
                NombreArchivo = nombreArchivo,
                S3Arn = arn,
                FechaSolicitado = DateTime.Now,
                Estado = "EN_PROGRESO"
            });
            await db.SaveChangesAsync();

            mensaje = $"Respaldo '{nombreArchivo}' solicitado. AWS lo está generando en segundo plano — dale a 'Actualizar estado' en un rato para ver cuándo termina.";
            esExito = true;
            await CargarRespaldos();
        }
        catch (Exception ex)
        {
            mensaje = $"Error al solicitar el respaldo: {ex.Message}";
            esExito = false;
        }
    }

    private async Task ActualizarEstados()
    {
        try
        {
            using var conn = new SqlConnection(Config.GetConnectionString("TorneoBadminton"));
            await conn.OpenAsync();
            using var cmd = conn.CreateCommand();
            cmd.CommandText = "EXEC msdb.dbo.rds_task_status @db_name=@db;";
            cmd.Parameters.AddWithValue("@db", "TorneoBadminton");

            var estadosPorArn = new Dictionary<string, string>();
            using (var reader = await cmd.ExecuteReaderAsync())
            {
                int colArn = reader.GetOrdinal("S3_object_arn");
                int colLifecycle = reader.GetOrdinal("lifecycle");
                while (await reader.ReadAsync())
                {
                    string arnTarea = reader.IsDBNull(colArn) ? "" : reader.GetString(colArn);
                    string lifecycle = reader.IsDBNull(colLifecycle) ? "" : reader.GetString(colLifecycle);
                    if (!string.IsNullOrEmpty(arnTarea))
                        estadosPorArn[arnTarea] = lifecycle;
                }
            }

            using var db = await DbFactory.CreateDbContextAsync();
            var pendientes = await db.RespaldosS3.Where(r => r.Estado == "EN_PROGRESO").ToListAsync();
            foreach (var r in pendientes)
            {
                if (estadosPorArn.TryGetValue(r.S3Arn, out var lifecycle))
                {
                    if (lifecycle == "SUCCESS") r.Estado = "COMPLETO";
                    else if (lifecycle == "ERROR") r.Estado = "ERROR";
                }
            }
            await db.SaveChangesAsync();

            mensaje = "Estados actualizados.";
            esExito = true;
            await CargarRespaldos();
        }
        catch (Exception ex)
        {
            mensaje = $"Error al actualizar estados: {ex.Message}";
            esExito = false;
        }
    }

    private async Task RestaurarRespaldo()
    {
        mensajeRestaurar = "";

        var elegido = respaldos.FirstOrDefault(r => r.Id == archivoSeleccionadoId && r.Estado == "COMPLETO");
        if (elegido == null)
        {
            mensajeRestaurar = "Selecciona un respaldo completo de la lista.";
            esExitoRestaurar = false;
            return;
        }

        if (textoConfirmacion != "RESTAURAR")
        {
            mensajeRestaurar = "Escribe RESTAURAR (en mayúsculas) para confirmar.";
            esExitoRestaurar = false;
            return;
        }

        bool confirmado = await JS.InvokeAsync<bool>("confirm",
            $"¿Restaurar '{elegido.NombreArchivo}'? Esto reemplaza TODOS los datos actuales con lo que había en ese respaldo. No se puede deshacer.");
        if (!confirmado) return;

        try
        {
            using var conn = new SqlConnection(Config.GetConnectionString("TorneoBadminton"));
            await conn.OpenAsync();
            using var cmd = conn.CreateCommand();
            cmd.CommandTimeout = 60;
            cmd.CommandText = "EXEC msdb.dbo.rds_restore_database @restore_db_name=@db, @s3_arn_to_restore_from=@arn;";
            cmd.Parameters.AddWithValue("@db", "TorneoBadminton");
            cmd.Parameters.AddWithValue("@arn", elegido.S3Arn);
            await cmd.ExecuteNonQueryAsync();

            mensajeRestaurar = "Restauración solicitada. AWS la está aplicando en segundo plano (puede tardar varios minutos y la base quedará inaccesible mientras tanto). Usa 'Actualizar estado' arriba para confirmar cuándo termina, y hasta entonces cierra y vuelve a abrir la aplicación, pidiendo a todos que vuelvan a entrar.";
            esExitoRestaurar = true;
            textoConfirmacion = "";
        }
        catch (Exception ex)
        {
            mensajeRestaurar = $"Error al restaurar: {ex.Message}";
            esExitoRestaurar = false;
        }
    }
}